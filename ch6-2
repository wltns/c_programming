#include <stdio.h>

int main() {
    int i;
    int a[5];
    int max1, max2;

    // 1. 5개의 정수 입력받기
    for(i = 0; i < 5; i++) {
        scanf("%d", &a[i]);
    }

    // 2. 첫 번째와 두 번째 숫자로 초기 1등, 2등 세팅하기
    if (a[0] > a[1]) {
        max1 = a[0];
        max2 = a[1];
    } else {
        max1 = a[1];
        max2 = a[0];
    }

    // 3. 세 번째 숫자(인덱스 2)부터 끝까지 돌면서 1등, 2등 갱신하기
    for(i = 2; i < 5; i++) {
        if(a[i] > max1) {
            // 현재 1등보다 큰 수가 나타나면
            max2 = max1; // 기존 1등은 2등으로 밀려남
            max1 = a[i]; // 새 숫자가 1등 차지
        } 
        else if(a[i] > max2) {
            // 1등보단 작지만 2등보다 큰 수가 나타나면
            max2 = a[i]; // 새 숫자가 2등 차지
        }
    }
    printf("%d\n%d\n", max1, max2);

    return 0;
}
