#include <stdio.h>
#include <string.h>

// 1. 단어를 공백 기준으로 분리하는 함수
int word_split(char str[], char tmp[][200]) {
    int i = 0; // 원본 문장 인덱스
    int k = 0; // 몇 번째 단어인지 (2차원 배열의 행)
    int j = 0; // 단어 내부의 글자 위치 (2차원 배열의 열)
    int len = strlen(str);

    for (i = 0; i < len; i++) {
        if (str[i] != ' ') {
            // 공백이 아니면 글자를 단어 배열에 순서대로 복사
            tmp[k][j++] = str[i];
        } else {
            // 공백을 만나면 현재 단어 완성
            if (j > 0) {
                tmp[k][j] = '\0'; // 문자열 마감 널 문자 넣기
                k++;              // 다음 단어 행으로 이동
                j = 0;            // 글자 위치 0으로 초기화
            }
        }
    }
    // 문장 맨 마지막 단어 마감 처리
    if (j > 0) {
        tmp[k][j] = '\0';
        k++;
    }

    return k; // 분리된 총 단어 개수 반환
}

// 2. 단어를 사전순으로 정렬하는 함수 (버블 정렬)
void word_sort(char tmp[][200], int n) {
    int i, j;
    char temp[200]; // 단어 바꿀 때 임시로 사용할 배열

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - 1 - i; j++) {
            // strcmp(A, B) > 0 이면 A가 B보다 사전순으로 뒤에 있음!
            if (strcmp(tmp[j], tmp[j + 1]) > 0) {
                strcpy(temp, tmp[j]);
                strcpy(tmp[j], tmp[j + 1]);
                strcpy(tmp[j + 1], temp);
            }
        }
    }
}

int main(void) {
    char str[200];          // 원본 문장 저장
    char tmp[20][200] = {0};// 분리된 단어들을 저장할 2차원 배열
    int word_count = 0;
    int i;

    // 1. 문장 입력받기 (gets 사용)
    gets(str);

    // 2. 단어 분리 실행
    word_count = word_split(str, tmp);

    // 3. 분리된 단어 줄바꿈 출력
    for (i = 0; i < word_count; i++) {
        puts(tmp[i]);
    }

    // 4. 사전순 정렬 실행
    word_sort(tmp, word_count);

    // 5. 정렬된 단어 한 줄로 출력
    for (i = 0; i < word_count; i++) {
        printf("%s ", tmp[i]);
    }
    printf("\n");

    return 0;
}
