int main() {

	// 영문자 10개 입력 받아 배열에 저장
	// 많이 나타난 문자와 그 빈도수 출력
	// 빈도수가 같은 문자가 여러 개이면 먼저 나타난 문자 출력
	// 배열 선언 제외한 모든 코드에서 배열 첨자 사용 불가 []
	int max_count = 0, current_count;
	char max_char, *p, *q, arr[10];

	for (p = arr; p < arr + 10; p++) { 
		scanf("%c", p);
	}
	// p는 arr[0]의 주소 값이므로, p가 arr[9]의 주소 안에 값까지 입력 받음
	for (p = arr; p < arr + 10; p++) {
		current_count = 0;
		for (q = arr; q < arr + 10; q++) {
			if (*p == *q) {
				current_count++
			}
		}
		if (current_count > max_count) {
			max_count = current_count;
			max_char = *p;
		}
	}
	printf("%c %d", max_char, max_count);

	return 0; 
}
