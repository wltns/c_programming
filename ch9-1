배열 선언 제외한 모든 코드에서 배열 첨자([])를 사용할 수 없고, 
오직 포인터 표기법(*, +)만 사용 / 빈도수가 같을 경우 먼저 나타난 문자를 출력

#include <stdio.h>

int main() {
    char a[10];       // 영문자 10개를 저장할 배열 선언  
    char *p = a;      // 배열의 시작 주소(&a[0])를 가리키는 포인터 p 선언
    int max_count = 0;  // 가장 많이 나타난 문자의 빈도수를 저장할 변수
    char max_char;      // 가장 많이 나타난 문자를 저장할 변수

    // 10개의 영문자 입력받기
    // 배열 첨자를 사용할 수 없으므로 포인터 연산(p + i)을 사용하여 입력받기
    for (int i = 0; i < 10; i++) {
        scanf("%c", p + i); // &a[i]에서 i 다음의 메모리 주소에 입력받기 
    }

    // 가장 많이 나타난 문자와 빈도수 찾기
    for (int i = 0; i < 10; i++) {
        int count = 0; // 현재 검사 중인 문자(*(p + i))의 빈도수를 저장할 변수

        // 배열의 처음부터 끝까지 순회하며 현재 문자와 같은 문자가 있는지 비교 
        for (int j = 0; j < 10; j++) {
            // 배열 첨자(a[i] == a[j]) 대신 포인터 표기법(*(p + i) == *(p + j)) 사용
            if (*(p + i) == *(p + j)) { // 포인터 p+i에 있는 값(*(p+i))과 p+j(0~9까지) 비교 
                count++; // 같은 문자를 발견하면 빈도수 1 증가
            }
        }
        // 최대 빈도수 갱신
        // 현재 문자의 빈도수(count)가 기존의 최대 빈도수(max_count)보다 클 때만 갱신
        // '>' 기호를 사용했기 때문에 빈도수가 같은 문자가 여러 개이더라도 
        // 갱신되지 않고 가장 먼저 나타난 문자가 그대로 유지
        if (count > max_count) {
            max_count = count;
            max_char = *(p + i); // *(p+i)에 있는 값
        }
    }

    printf("%c %d\n", max_char, max_count);

    return 0;
}
