int main() {
    int ar[50];     
    int *p = ar;    // 배열 시작 주소를 포인터 p에 연결
    int N, a, b;

    scanf("%d", &N); // 입력 시에 & 주소 연산자 붙이

    for (p=ar; p<ar+N; p++) {
        scanf("%d", p);
    }

    scanf("%d %d", &a, &b);

    // swap 함수 호출 (포인터 연산으로 해당 인덱스의 '주소'를 넘겨줌)
    // p가 배열의 시작 주소이므로, p + a는 a번째 원소의 주소
    swap(p + a, p + b);

    for (p=ar; p<ar+N; p++) {
        printf("%d ", *p);
    }
    return 0;
}

 void swap(int *x, int *y){
    int temp = *x;  // x가 가리키는 원본 값을 temp에 임시 저장
    *x = *y;       // y가 가리키는 원본 값을 x가 가리키는 곳에 덮어씀
    *y = temp;      // temp에 저장해둔 값을 y가 가리키는 곳에 넣음
}
