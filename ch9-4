#include <stdio.h>

// 1. int 자료형 명시, p3와 n 추가 전달
void addArray(int *p1, int *p2, int *p3, int n){
    // 2. main의 변수가 아닌 매개변수 p1, p2, p3, n 사용
    for (int i = 0; i < n; i++){
        // 3. n - 1 - i 역방향 공식 사용
        *(p3 + i) = *(p1 + i) + *(p2 + (n - 1 - i));
    }    
}

int main(){
    int n, ar[20], br[20], i, cr[20];
    
    scanf("%d", &n);
    
    for(i = 0; i < n; i++){
        scanf("%d", ar + i);
    }

    for(i = 0; i < n; i++){
        scanf("%d", br + i);
    }

    // 4. addArray 함수 호출
    addArray(ar, br, cr, n);

    // 5. 결과 배열 cr 출력
    for(i = 0; i < n; i++){
        printf("%d ", *(cr + i));
    }
    return 0;
}
