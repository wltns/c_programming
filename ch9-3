#inlcude <stdio.h>
// mid 함수 정의: 배열의 시작 주소를 받아 중앙값이 저장된 '주소(int*)'를 반환
int* mid(int *p) {
    int a = *p;         // 0번 원소의 값
    int b = *(p + 1);   // 1번 원소의 값
    int c = *(p + 2);   // 2번 원소의 값

    // a가 중앙값인 경우 (b와 c 사이에 있는 경우)
    if ((a >= b && a <= c) || (a <= b && a >= c)) {
        return p;       // 0번 원소의 주소 반환
    }
    // b가 중앙값인 경우 (a와 c 사이에 있는 경우)
    else if ((b >= a && b <= c) || (b <= a && b >= c)) {
        return p + 1;   // 1번 원소의 주소 반환
    }
    // 둘 다 아니면 c가 중앙값
    else {
        return p + 2;   // 2번 원소의 주소 반환
    }
}

int main() {
    int arr[3];         // 3개의 정수를 저장할 배열 선언
    int *p = arr;       // 배열의 시작 주소를 가리키는 포인터

    // 세 개의 정수 입력받기 (포인터 연산 사용)
    for (int i = 0; i < 3; i++) {
        scanf("%d", p + i);
    }

    // mid 함수 호출 
    // mid 함수는 중앙값이 위치한 '주소'를 던져주므로, 이를 주소 변수(int *pmid)로 받습니다.
    int *pmid = mid(p);

    // 전달받은 주소에 들어있는 진짜 값(*pmid)을 출력
    printf("%d\n", *pmid);

    return 0;
}
