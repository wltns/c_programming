#include <stdio.h>

// 1. main 함수 위에 mid 함수 선언
int* mid(int *arr);

int main() {
    int arr[3];      
    int *p = arr;        

    // 세 개의 정수 입력받기
    for (p = arr; p < arr + 3; p++) {
        scanf("%d", p);
    }

    // mid 함수 호출 
    int *pmid = mid(arr);

    // 전달받은 주소에 들어있는 진짜 값(*pmid)을 출력
    printf("%d\n", *pmid);

    return 0;
}

// 2. 중앙값의 주소를 반환하는 함수 정의
int* mid(int *arr) {
    // a가 중앙값인 경우
    if ((*arr >= *(arr + 1) && *arr <= *(arr + 2)) || (*arr <= *(arr + 1) && *arr >= *(arr + 2))) {
        return arr;        
    }
    // b가 중앙값인 경우 
    else if ((*(arr + 1) >= *arr && *(arr + 1) <= *(arr + 2)) || (*(arr + 1) <= *arr && *(arr + 1) >= *(arr + 2))) {
        return arr + 1;   
    }
    // 둘 다 아니면 c가 중앙값
    else {
        return arr + 2;   
    }
}
