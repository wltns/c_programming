int main() {
    int arr[3];      
    int *p = arr;       // 배열의 시작 주소를 가리키는 포인터

    // 세 개의 정수 입력받기 (포인터 연산 사용)
    for (p=arr; p<arr+3; p++) {
        scanf("%d", p);
    }

    // mid 함수 호출 
    // mid 함수는 중앙값이 위치한 '주소'를 던져주므로, 이를 주소 변수(int *pmid)로 받습니다.
    int *pmid = mid(arr);

    // 전달받은 주소에 들어있는 진짜 값(*pmid)을 출력
    printf("%d\n", *pmid);

    return 0;
}
// 주소를 알아내서 값을 구함 
// mid 함수 정의: 배열의 시작 주소를 받아 중앙값이 저장된 '주소(int*)'를 반환
int* mid(int *arr) {
    // arr가 중앙값인 경우 (arr+1과 arr+2 사이에 있는 경우)
    if ((*arr >= *(arr+1) && *arr <= *(arr+2)) || (*arr <= *(arr+1) && *(arr >= arr+2))) {
        return arr;       // 0번 원소의 주소 반환
    }
    // b가 중앙값인 경우 (a와 c 사이에 있는 경우)
    else if ((*(arr+1) >= *arr && *(arr+1) <= *(arr+2) || (*(arr+1) <= *arr && (*(arr+1) >= *(arr+2))) {
        return arr + 1;   // 1번 원소의 주소 반환
    }
    // 둘 다 아니면 c가 중앙값
    else {
        return arr + 2;   // 2번 원소의 주소 반환
    }
}

